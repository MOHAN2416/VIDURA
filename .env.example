# VIDURA Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Settings
APP_NAME=VIDURA
APP_ENV=development
LOG_LEVEL=INFO

# Database Settings
VIDURA_DB_PATH=data/vidura.db

# Local Model (Ollama) Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Agent Settings
AGENT_MAX_STEPS=10

# Optional Ollama Cloud / Developer Model Settings (For controlled developer tasks in future phases)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=
