# ==============================================================================
# VIDURA Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=VIDURA
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Workspace & Database Settings
# ------------------------------------------------------------------------------
VIDURA_WORKSPACE_ROOT=.
VIDURA_DB_PATH=data/vidura.db

# ------------------------------------------------------------------------------
# 3. Local Model (Ollama) Settings
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
VIDURA_LOCAL_MODEL=gemma4:e4b-it-qat
VIDURA_MODEL_PROVIDER=local

# ------------------------------------------------------------------------------
# 4. Agent Loop Settings
# ------------------------------------------------------------------------------
AGENT_MAX_STEPS=10

# ------------------------------------------------------------------------------
# 5. Model Routing & Developer Model Settings
# ------------------------------------------------------------------------------
# Routing mode: "auto" (complexity-based), "local", or "cloud"
VIDURA_ROUTING_MODE=auto
# Developer task provider: "auto", "local", or "cloud"
VIDURA_DEVELOPER_MODEL_PROVIDER=auto

# ------------------------------------------------------------------------------
# 6. Cloud Model (Ollama Cloud) & Security Guardrails
# ------------------------------------------------------------------------------
VIDURA_CLOUD_ENABLED=true
VIDURA_CLOUD_FALLBACK_ENABLED=false
VIDURA_CLOUD_MODEL=gemma4:31b-cloud
VIDURA_CLOUD_ENDPOINT=https://ollama.com
VIDURA_CLOUD_API_KEY=
VIDURA_CLOUD_TIMEOUT_SECONDS=60.0
# Request budget caps (leave blank or 0 for unlimited)
VIDURA_CLOUD_MAX_REQUESTS=
VIDURA_CLOUD_MAX_DEVELOPER_REQUESTS=
VIDURA_CLOUD_MAX_CONTEXT_TOKENS=32000
VIDURA_CLOUD_USAGE_RETENTION_DAYS=30
VIDURA_CLOUD_INPUT_TOKEN_PRICE=
VIDURA_CLOUD_OUTPUT_TOKEN_PRICE=

# ------------------------------------------------------------------------------
# 7. Developer Testing Settings
# ------------------------------------------------------------------------------
VIDURA_TEST_TIMEOUT_SECONDS=30
VIDURA_TEST_OUTPUT_LIMIT=50000

# ------------------------------------------------------------------------------
# 8. Self-Development Settings (Phase 10)
# ------------------------------------------------------------------------------
# Disabled by default for safety; requires explicit human intent
VIDURA_SELF_DEVELOPMENT_ENABLED=false
VIDURA_SELF_DEVELOPMENT_SAFETY_MODE=true

# ------------------------------------------------------------------------------
# 9. Experience Memory & Learning Settings (Phase 11)
# ------------------------------------------------------------------------------
VIDURA_EXPERIENCE_MEMORY_ENABLED=true
VIDURA_EXPERIENCE_RETRIEVAL_ENABLED=true
VIDURA_EXPERIENCE_MAX_RESULTS=5
VIDURA_EXPERIENCE_MIN_RELEVANCE=0.2

# ------------------------------------------------------------------------------
# 10. RAG & Codebase Intelligence Settings (Phase 12)
# ------------------------------------------------------------------------------
VIDURA_RAG_ENABLED=true
VIDURA_RAG_EMBEDDING_MODEL=all-minilm
VIDURA_RAG_TOP_K=5
VIDURA_RAG_CHUNK_SIZE=500
VIDURA_RAG_CHUNK_OVERLAP=50
VIDURA_RAG_MAX_CONTEXT_TOKENS=4000
VIDURA_RAG_MIN_SCORE=0.15

